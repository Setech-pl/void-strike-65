diff --git a/src/c/l2.c b/src/c/l2.c
index fd408cd..d72302b 100644
--- a/src/c/l2.c
+++ b/src/c/l2.c
@@ -41,6 +41,7 @@ void l2_c_enter(void)
         while(l2_at<l2_until) { ++l2_tag; LOOKUP[l2_at]=l2_tag; ++l2_at; }
         l2_i+=L2_RECORD_BYTES; --l2_count;
     }
+
 }
 
 #pragma rodata-name ("L2")
@@ -67,3 +68,18 @@ void l2_warning_set_timer(void)
     else
         ((volatile unsigned char*)L2_TIMERS)[BYTE(L2_WORK_SLOT)]=25u;
 }
+
+/* SPIKE contact mine: collision executor reports a lethal shot/contact.
+ * C owns the irreversible consumed state; death/respawn never resets LOOKUP. */
+void l2_mine_consume(void) { LOOKUP[l2_module]=0u; }
+
+void l2_mine_enter(void)
+{
+    /* SPIKE: host-generated event modules; one bounded list, no Director RNG. */
+    if(BYTE(L2_SECTOR_INDEX)==EXT[3u]) {
+        l2_count=EXT[70u];
+        for(l2_i=0u;l2_i<l2_count;++l2_i) {
+            l2_at=((volatile unsigned char*)(L2_EXTENSION+71u))[l2_i]; LOOKUP[l2_at]=128u;
+        }
+    }
+}
diff --git a/src/hybrid/l2.s b/src/hybrid/l2.s
