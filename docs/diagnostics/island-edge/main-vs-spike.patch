     lda #>L2_BRAKE
 l2_store_hook_hi:
     sta profile_after_player+2
     rts
+.include "l2-mines.inc"
 l2_end:
 .export l2_start,l2_end,l2_interval,l2_draw_row,l2_contact,l2_island_contact,l2_commit_row,l2_recipes
 .export l2_space,l2_enter,l2_rearm
