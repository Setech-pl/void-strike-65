     beq @none
     sec
     sbc #1
@@ -113,6 +114,7 @@ l2_interval:
 
     .res 7,0                       ; state gate moved resident; retain hot addresses
 l2_contact:
+    jsr l2_mine_tick
     lda player_x
     cmp #148
     bcs @base
@@ -273,7 +275,7 @@ l2_draw_row:
     adc l2_palette
     sta (dst_ptr),y
 @done:
-    rts
+    jmp l2_mine_draw_row
 
 l2_commit_row:
     ldy #39
@@ -319,12 +321,14 @@ l2_space:
 .assert >integration_update_enemy <> 0, error, "L2 SPACE tail requires a nonzero resident page"
 l2_enter:
     jsr _l2_c_enter                 ; C decides/initializes the capital geometry
+    jsr _l2_mine_enter
     lda #<L2_BRAKE
