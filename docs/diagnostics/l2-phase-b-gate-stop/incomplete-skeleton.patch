@@ -0,0 +1,3 @@
+# §BW: phase-exclusive with boss slot D / boss-death; never boot transported.
+MEMORY { L2_RAM: start = $1900, size = $0700, type = rw, file = %O, fill = yes, define = yes; }
+SEGMENTS { L2: load = L2_RAM, type = rw, define = yes; }
