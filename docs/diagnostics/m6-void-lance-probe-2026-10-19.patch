diff -ruN --exclude=build --exclude=dist --exclude=node_modules --exclude=logs base/tests/lance-probe.mjs probe/tests/lance-probe.mjs
--- base/tests/lance-probe.mjs	1970-01-01 01:00:00
+++ probe/tests/lance-probe.mjs	2026-10-19 23:06:44
@@ -0,0 +1,141 @@
+// build/m6-probe ONLY (M6 Phase A): the VOID LANCE probe's states inside the
+// boss stress compositions (tests/boss-stress.test.mjs and the three
+// scripts/measure-boss-stress-*.mjs tools, patched in the probe tree only).
+//
+// LANCE_MODE (environment):
+//   off     no lance tick (the probe build's DLI changes still count)
+//   idle    a lance in stock, FIRE released, the ship moved under a front
+//           module and the reticle's target changed with its line (a redraw)
+//   charge  FIRE held, the charge under way (shown frame, V3's fill step),
+//           the target changed with its line (a redraw)
+//   fire    FIRE held, the charge completing this frame: the reticle off and
+//           the beam's first LANCE_BEAM_STEP lines
+//   arrive  the beam's last LANCE_BEAM_STEP lines reach the module: the kill
+//           through boss_hit. Applied to one-meeting kill cases only (the
+//           case's one module killed by the lance, its player shot removed:
+//           ordinary fire is suspended for the 75 charge frames); with
+//           LANCE_ARRIVE_SHOTS=1 also to two-meeting kill cases, one module
+//           the lance's and the other a player shot's.
+// Each case's figure is the composition's frame plus the tick's cycles
+// (call(), its RTS included: TICK_FLASHES's jsr / jmp / rts cost the same
+// as boss_rts's in the base build).
+import { call, label, labelsOf } from "./boss-harness.mjs";
+
+export const lanceMode = process.env.LANCE_MODE ?? "off";
+const arriveShots = process.env.LANCE_ARRIVE_SHOTS === "1";
+const has = labelsOf.boss.has("lance_tick");
+const lbl = (name) => label("boss", name);
+const main = (name) => label("main", name);
+const armed = new WeakSet();
+const skipped = new WeakSet();
+// "arrive": a case the lance does not take is left out of the figure (its frames cost 0).
+export const lanceSkip = (memory) => skipped.has(memory);
+export const lanceStats = { armed: 0, skipped: 0, ticks: 0, worstTick: 0 };
+
+const BAND_ORIGIN_HPOS = 32;
+const STEP = Number(process.env.LANCE_BEAM_STEP ?? 40);
+const SHIP_Y = 200;                                     // the ship's top line in the fight (PMG Y 32-225)
+
+function visible(memory) {
+  const p = memory[lbl("boss_shown_pos")];
+  return { p, left: Math.ceil((16 + p) / 4), right: Math.floor((175 + p) / 4) };
+}
+function exposed(memory, module) {
+  const bits = memory[lbl("_boss_exposed_lo")] | (memory[lbl("_boss_exposed_hi")] << 8);
+  return ((bits >> module) & 1) !== 0;
+}
+// A column the ship can stand under whose front module the reticle takes.
+function targetColumn(memory, avoid = []) {
+  const { p, left, right } = visible(memory);
+  const count = memory[lbl("_boss_count")];
+  const map = lbl("boss_column_map");
+  let fallback = null;
+  for (let c = Math.max(left, 14); c <= right; c += 1) {
+    const module = memory[map + c];
+    if (module >= count || memory[lbl("_boss_hp") + module] === 0 || !exposed(memory, module)) continue;
+    const x = c * 4 + BAND_ORIGIN_HPOS - p - 8 + 1;
+    if (x < 48 || x > 191) continue;
+    if (!avoid.includes(module)) return { c, module, x };
+    fallback ??= { c, module, x };
+  }
+  return fallback;
+}
+function shipUnder(memory, x) { memory[main("player_x")] = x; }
+function forceRedraw(memory, module) {
+  memory[lbl("lance_tgt1")] = 0;
+  if (labelsOf.boss.has("lance_fixed_y")) {
+    // One line for every module: drawn once, at the first armed frame; a
+    // target change is an HPOS change only.
+    // the line under the band's last shown row, as boss_band_measure gives it
+    if (memory[lbl("lance_y")] === 0) memory[lbl("lance_y")] = call(memory, lbl("boss_band_measure")).a;
+    return;
+  }
+  const line = memory[lbl("boss_mbottom_y") + module];
+  const variant3 = labelsOf.boss.has("lance_fill_step");
+  const y = line - (variant3 ? 24 : 8);
+  memory[lbl("lance_y")] = y - 8 >= 24 ? y - 8 : y + 8;
+}
+
+// Arms `memory` (one case's run image) for the mode. hit / mode / columnOf:
+// the case's own meetings, for "arrive".
+export function lanceArm(memory, { hit = [], mode = "kill", columnOf = () => undefined } = {}) {
+  if (!has || lanceMode === "off") return;
+  memory[main("player_y")] = SHIP_Y;
+  if (lanceMode === "ship") {
+    // The ship moved as the reticle modes move it, no tick: the composition's
+    // own change from the ship's place, so mode - ship is the lance's alone.
+    const target = targetColumn(memory, hit);
+    if (target !== null) shipUnder(memory, target.x);
+    return;
+  }
+  memory[lbl("lance_stock")] = 1;
+  memory[lbl("lance_beam")] = 0;
+  memory[lbl("lance_charge")] = 0;
+  memory[0xd010] = 1;                                   // TRIG0 released
+  if (lanceMode === "arrive") {
+    const real = hit.filter((h) => h !== "hull");
+    if (mode !== "kill" || real.length < 1 || real.length > (arriveShots ? 2 : 1) || real.length !== hit.length) {
+      lanceStats.skipped += 1;
+      skipped.add(memory);
+      return;
+    }
+    const module = real[0];
+    const column = columnOf(module);
+    if (column === undefined) { lanceStats.skipped += 1; skipped.add(memory); return; }
+    // The lance's module: its player shot (slot 0, the first met) removed.
+    memory[main("FIGHTER_PROJECTILE_ACTIVE")] = 0;
+    const top = memory[lbl("boss_mbottom_y") + module];
+    memory[lbl("lance_beam")] = 1;
+    memory[lbl("lance_target")] = module;
+    memory[lbl("lance_col")] = column;
+    memory[lbl("lance_top")] = top;
+    memory[lbl("lance_head")] = Math.min(255, top + STEP);
+    memory[lbl("lance_bottom")] = memory[main("player_y")];
+    armed.add(memory);
+    lanceStats.armed += 1;
+    return;
+  }
+  const target = targetColumn(memory, hit);
+  if (target === null) { lanceStats.skipped += 1; return; }
+  shipUnder(memory, target.x);
+  forceRedraw(memory, target.module);
+  if (lanceMode === "charge") {
+    memory[0xd010] = 0;                                 // FIRE held
+    memory[lbl("lance_charge")] = 11;                   // shown frame (12 & 2 = 0); V3: the fill's third row due
+    if (labelsOf.boss.has("lance_fill_drawn")) memory[lbl("lance_fill_drawn")] = 1;
+  } else if (lanceMode === "fire") {
+    memory[0xd010] = 0;
+    memory[lbl("lance_charge")] = 74;                   // completes on this frame
+  }
+  armed.add(memory);
+  lanceStats.armed += 1;
+}
+
+// The tick, on armed images only (the setup frames run without it).
+export function lanceTick(memory) {
+  if (!armed.has(memory)) return 0;
+  const cycles = call(memory, lbl("lance_tick")).cycles;
+  lanceStats.ticks += 1;
+  lanceStats.worstTick = Math.max(lanceStats.worstTick, cycles);
+  return cycles;
+}
