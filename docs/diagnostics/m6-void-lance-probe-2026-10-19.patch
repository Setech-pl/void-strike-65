diff -ruN --exclude=build --exclude=dist --exclude=node_modules --exclude=logs base/src/hybrid/lance.s probe/src/hybrid/lance.s
--- base/src/hybrid/lance.s	1970-01-01 01:00:00
+++ probe/src/hybrid/lance.s	2026-10-19 23:06:44
@@ -0,0 +1,483 @@
+
+; ===========================================================================
+; build/m6-probe ONLY (M6 Phase A, docs/plans/m6-void-lance.md): the VOID
+; LANCE probe. Not production code; it lives in the region charset's codes
+; 100-127 ($0F20-$0FFF) only so that the probe build can carry it.
+;
+;   lance_tick       every boss-sector frame from the capital vector table's
+;                    TICK_FLASHES entry (a boss_rts entry in production):
+;                    the target under the ship's centre, the reticle on P1 /
+;                    P2, the charge while FIRE is held (ordinary fire
+;                    suspended through gameplay_fire_gate), the fire.
+;   lance_beam_frame the beam in the ship's own plane (P0, double width, the
+;                    ship's colour): it grows up from the ship's top
+;                    LANCE_BEAM_STEP lines a frame; on the frame it reaches
+;                    the module's bottom line the module is destroyed through
+;                    boss_hit with its HP set to 1 (the existing kill path:
+;                    spark, score, rebuild, capsule, exposure); held, then
+;                    erased LANCE_BEAM_STEP lines a frame.
+;
+;   -D LANCE_VARIANT=1  brackets [ ] (P1 left, P2 right), blink while charging
+;   -D LANCE_VARIANT=2  one crosshair (P1), blink while charging
+;   -D LANCE_VARIANT=3  one column marker (P1) above the module, filling
+;   -D LANCE_DEMO=1     a lance always in stock; FIRE replaced by a fixed
+;                       cycle (60 frames released, 90 held of 160)
+;   -D LANCE_NO_CORE=1  the reticle never takes a module of kind CORE
+;   -D LANCE_BEAM_STEP=n
+; ===========================================================================
+.ifndef LANCE_VARIANT
+LANCE_VARIANT   = 1
+.endif
+.ifndef LANCE_BEAM_STEP
+LANCE_BEAM_STEP = 40
+.endif
+LANCE_P0        = $3C00
+LANCE_P1        = $3D00
+LANCE_P2        = $3E00
+LANCE_HPOSP1    = $D001
+LANCE_HPOSP2    = $D002
+LANCE_SIZEP1    = $D009
+LANCE_SIZEP2    = $D00A
+LANCE_TRIG0     = $D010
+gameplay_fire_gate = $9E               ; main (zero page, build/void-strike-65.lbl at 3d59ded)
+LANCE_CHARGE    = 75                    ; 1.5 s at 50 Hz
+LANCE_HOLD      = 3                     ; frames the whole beam stays
+LANCE_BEAM_BITS = $18                   ; P0 is double width: 4 colour clocks at the ship's centre
+LANCE_COLOUR    = $CA                   ; green, hue C: 4 hue steps from the ally steel $88
+.if LANCE_VARIANT = 3
+LANCE_ROWS      = 16
+.else
+LANCE_ROWS      = 8
+.endif
+
+.segment "LANCE_CODE"
+
+lance_tick:
+    lda lance_beam
+    beq @aim
+    jmp lance_beam_frame
+@aim:
+.ifdef LANCE_DEMO
+    lda #$01
+    sta lance_stock
+    inc lance_demo
+    lda lance_demo
+    cmp #160
+    bcc :+
+    lda #$00
+    sta lance_demo
+:
+    cmp #60                             ; C=1: held
+    lda #$00
+    rol
+    eor #$01                            ; 0 held, 1 released (TRIG0's sense)
+    sta lance_trig
+.else
+    lda LANCE_TRIG0
+    sta lance_trig
+.endif
+    lda lance_stock
+    bne :+
+    rts
+:
+    lda PLAYER_LIFECYCLE
+    beq :+
+    jmp @lose
+:
+    ; The band column under the ship's centre (player_x + 8), as boss_shot_meet
+    ; finds a shot's: (x - BAND_ORIGIN_HPOS + p) / 4.
+    lda player_x
+    clc
+    adc boss_shown_pos
+    sec
+    sbc #(BAND_ORIGIN_HPOS - 8)
+    lsr
+    lsr
+    sta lance_now
+    tay
+    ldx boss_column_map,y
+    cpx #BOSS_MAX_MODULES               ; ARMOUR / OPEN: nothing a shot could hurt
+    bcs @lose
+    lda _boss_hp,x
+    beq @lose
+    txa
+    and #$07
+    tay
+    lda boss_bit,y
+    cpx #$08
+    bcs @hi
+    and _boss_exposed_lo                ; C=0
+    bcc @exposed
+@hi:
+    and _boss_exposed_hi
+@exposed:
+    beq @lose                           ; covered: a shot would be absorbed
+.ifdef LANCE_NO_CORE
+    lda _boss_kind,x
+    cmp #BOSS_KIND_CORE
+    beq @lose
+.endif
+    inx
+    cpx lance_tgt1
+    beq @kept
+    stx lance_tgt1
+    dex
+    jsr lance_place
+    jmp @aimed
+@kept:
+    dex
+@aimed:
+    jsr lance_hpos
+    lda lance_trig
+    bne @released
+    lda #$00
+    sta gameplay_fire_gate              ; the ordinary fire waits (read_input re-arms it on release)
+    inc lance_charge
+    lda lance_charge
+    cmp #LANCE_CHARGE
+    bcc :+
+    jmp @fire
+:
+.if LANCE_VARIANT = 3
+    jmp @show
+.else
+    and #$02                            ; a 2-frame blink
+    beq @show
+    lda #$00
+    sta LANCE_HPOSP1
+    sta LANCE_HPOSP2
+    rts
+.endif
+@released:
+    lda lance_charge
+    beq @show
+    lda #$00
+    sta lance_charge
+@show:
+.if LANCE_VARIANT = 3
+    jsr lance_fill_step                 ; one row a frame toward the charge (empties as well)
+.endif
+    lda lance_h1
+    sta LANCE_HPOSP1
+    lda lance_h2
+    sta LANCE_HPOSP2
+@rts:
+    rts
+@lose:
+    lda lance_tgt1
+    beq @rts
+    lda #$00
+    sta lance_tgt1
+    sta LANCE_HPOSP1
+    sta LANCE_HPOSP2
+    lda lance_charge
+    beq @rts
+    lda #$00
+    sta lance_charge
+    lda lance_trig
+    bne @rts
+    lda #$01
+    sta gameplay_fire_gate              ; still held: the ordinary fire at once
+    rts
+@fire:
+    lda #$00
+    sta lance_charge
+    sta lance_tgt1
+    sta LANCE_HPOSP1
+    sta LANCE_HPOSP2
+.ifndef LANCE_DEMO
+    dec lance_stock
+.endif
+    stx lance_target
+    lda lance_now
+    sta lance_col
+    lda boss_mbottom_y,x
+    sta lance_top
+    lda player_y
+    sta lance_head
+    sta lance_bottom
+    lda #$01
+    sta lance_beam
+    rts                                 ; the beam grows from the next frame: the kill never shares the fire frame
+
+; The beam: 1 growing, 2 held, 3 erased.
+lance_beam_frame:
+    lda lance_beam
+    cmp #$02
+    beq @hold
+    bcs @erase
+.ifdef LANCE_BEAM_ONE
+    lda lance_top
+.else
+    lda lance_head
+    sec
+    sbc #LANCE_BEAM_STEP
+    bcc @clip
+    cmp lance_top
+    bcs @limit
+@clip:
+    lda lance_top
+@limit:
+.endif
+    sta lance_lim
+    ldy lance_head
+    lda #LANCE_BEAM_BITS
+@grow:
+    dey
+    sta LANCE_P0,y
+    cpy lance_lim
+    bne @grow
+    sty lance_head
+    cpy lance_top
+    bne @done
+    ; It reached the module: the kill, through the shot's own path.
+    ldx lance_target
+    lda #$01
+    sta _boss_hp,x
+    stx _boss_hit_module
+    lda lance_col
+    sta _boss_hit_cell
+    jsr boss_hit
+    lda #LANCE_HOLD
+    sta lance_hold
+    lda #$02
+    sta lance_beam
+@done:
+    rts
+@hold:
+    dec lance_hold
+    bne @done
+    lda #$03
+    sta lance_beam
+    rts
+@erase:
+    lda lance_head                      ; erase down from the top
+    clc
+    adc #LANCE_BEAM_STEP
+    bcs @end
+    cmp lance_bottom
+    bcc :+
+@end:
+    lda lance_bottom
+:
+    cmp player_y                        ; never into the ship's own rows
+    bcc :+
+    lda player_y
+:
+    sta lance_lim
+    ldy lance_head
+    cpy lance_lim
+    bcs @off
+    lda #$00
+@wipe:
+    sta LANCE_P0,y
+    iny
+    cpy lance_lim
+    bne @wipe
+    sty lance_head
+    cpy lance_bottom
+    bcc @done
+@off:
+    lda #$00
+    sta lance_beam
+    rts
+
+; X = the new target: the reticle's rows at its bottom line (V1 / V2: over
+; its bottom row; V3: the 16 lines above it), redrawn only when that line
+; changes - the shape is the same for every module. Keeps X.
+lance_place:
+.ifdef LANCE_FIXED_Y
+    ; -D LANCE_FIXED_Y: one line for every module - the lines right under the
+    ; band's last shown row (slot D's boss_band_measure, once) - drawn once;
+    ; only the HPOS follows the target.
+    lda lance_y
+    bne lance_rts
+    stx lance_x
+    jsr boss_band_measure               ; A = the line under the band's last row with a cell
+    sta lance_y
+    jsr lance_draw
+    ldx lance_x
+    rts
+.else
+    lda boss_mbottom_y,x
+    sec
+.if LANCE_VARIANT = 3
+    sbc #(8 + LANCE_ROWS)
+.else
+    sbc #8
+.endif
+.endif
+    cmp lance_y
+    beq lance_rts
+    stx lance_x
+    pha
+    ldy lance_y
+    beq @fresh
+    ldx #LANCE_ROWS                     ; the old rows off
+    lda #$00
+:
+    sta LANCE_P1,y
+.if LANCE_VARIANT = 1
+    sta LANCE_P2,y
+.endif
+    iny
+    dex
+    bne :-
+@fresh:
+    pla
+    sta lance_y
+    jsr lance_draw
+    ldx lance_x
+lance_rts:
+    rts
+
+; The reticle's rows at lance_y (A, X, Y).
+lance_draw:
+    lda #$00
+    sta lance_fill_drawn
+    sta LANCE_SIZEP1
+    sta LANCE_SIZEP2
+    ldy lance_y
+    ldx #$00
+:
+.if LANCE_VARIANT = 1
+    lda lance_shape_l,x
+    sta LANCE_P1,y
+    lda lance_shape_r,x
+    sta LANCE_P2,y
+.else
+    lda lance_shape,x
+    sta LANCE_P1,y
+.endif
+    iny
+    inx
+    cpx #LANCE_ROWS
+    bne :-
+    rts
+
+; X = the target: the HPOS the reticle takes this frame (the band drifts).
+lance_hpos:
+.if LANCE_VARIANT = 1
+    lda boss_mx,x
+    asl
+    asl
+    sec
+    sbc boss_shown_pos
+    clc
+    adc #(BAND_ORIGIN_HPOS - 3)
+    sta lance_h1
+    lda boss_mxe,x
+    asl
+    asl
+    sec
+    sbc boss_shown_pos
+    clc
+    adc #(BAND_ORIGIN_HPOS - 5)
+    sta lance_h2
+.else
+    lda boss_mx,x
+    clc
+    adc boss_mxe,x
+    asl
+    sec
+    sbc boss_shown_pos
+    clc
+    adc #(BAND_ORIGIN_HPOS - 4)
+    sta lance_h1
+    lda #$00
+    sta lance_h2
+.endif
+    rts
+
+.if LANCE_VARIANT = 3
+; The marker follows the charge one row a frame: a row filled every 5 frames
+; of the charge, emptied a row a frame once it ends. Keeps X.
+lance_fill_step:
+    lda lance_charge
+    ldy #$FF
+:
+    iny
+    sec
+    sbc #5
+    bcs :-
+    cpy #(LANCE_ROWS - 2)
+    bcc :+
+    ldy #(LANCE_ROWS - 2)
+:
+    cpy lance_fill_drawn
+    beq @rts
+    lda #$3C
+    bcs @more                           ; C from the CPY: Y > drawn
+    lda lance_fill_drawn
+    dec lance_fill_drawn
+    ldy #$24
+    bne @row
+@more:
+    inc lance_fill_drawn
+    lda lance_fill_drawn
+    ldy #$3C
+@row:
+    eor #$FF
+    sec
+    adc #(LANCE_ROWS - 1)               ; the row from the top: 15 - filled
+    clc
+    adc lance_y
+    sty lance_bits
+    tay
+    lda lance_bits
+    sta LANCE_P1,y
+@rts:
+    rts
+.endif
+
+.if LANCE_VARIANT = 1
+lance_shape_l:  .byte $E0, $80, $80, $00, $00, $80, $80, $E0
+lance_shape_r:  .byte $07, $01, $01, $00, $00, $01, $01, $07
+.elseif LANCE_VARIANT = 2
+lance_shape:    .byte $18, $18, $00, $C3, $C3, $00, $18, $18
+.else
+lance_shape:    .byte $3C, $24, $24, $24, $24, $24, $24, $24
+                .byte $24, $24, $24, $24, $24, $24, $24, $3C
+.endif
+
+; The band DLI's phase 1 (A only): under the band P1 / P2's registers are
+; the lasers' M1 / M2 colours again.
+lance_dli_under:
+    lda b2_colour
+    sta COLPM1
+    lda b2_colour+1
+    sta COLPM2
+    rts
+
+; The DLI's phase 0 publishes this as COLPM1 / COLPM2 for the band's rows
+; (phase 1 gives the lasers their colour back under the band).
+lance_colour:   .byte LANCE_COLOUR
+
+.segment "LANCE_BSS"
+lance_stock:    .res 1
+lance_charge:   .res 1
+lance_tgt1:     .res 1                  ; the target + 1, 0 none
+lance_target:   .res 1
+lance_now:      .res 1
+lance_col:      .res 1
+lance_y:        .res 1                  ; the reticle's first row, 0 none
+lance_h1:       .res 1
+lance_h2:       .res 1
+lance_trig:     .res 1
+lance_beam:     .res 1
+lance_hold:     .res 1
+lance_head:     .res 1
+lance_top:      .res 1
+lance_bottom:   .res 1
+lance_lim:      .res 1
+lance_fill:     .res 1
+lance_fill_drawn: .res 1
+lance_demo:     .res 1
+lance_x:        .res 1
+lance_bits:     .res 1
+.export lance_tick, lance_stock, lance_charge, lance_tgt1, lance_y, lance_beam, lance_head, lance_top
+.export lance_trig, lance_target, lance_demo, lance_fill_drawn, lance_col, lance_bottom
+.ifdef LANCE_FIXED_Y
+lance_fixed_y = 1
+.export lance_fixed_y
+.endif
