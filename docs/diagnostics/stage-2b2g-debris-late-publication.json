  "change": {
    "fighter_open": "entity_debris_publish (erase + render, adjacent) runs inside the post-playfield window after wait_frame_at_line $77, called from light_publish between the Light erase and the Light render; the frame-start debris erase (entity_effects_erase) and the mid-frame debris render (entity_effects_render) are removed",
    "capital": "the same entity_debris_publish runs right after the entity update (render_launch_flashes_with_capital_debris, operand-only hook of the main loop), in the vertical blank, after every transient restore (capital explosion tick, launch flash, muzzle, broadside erase) and before every transient capture (launch flash, capital explosion, broadside span); broadside shells are now drawn above the debris",
    "exact_ownership_erase": "erase_interactive_entity_overlays restores a cell only while the ring byte equals the code this record published (ENTITY_BACKING2/3); cells overwritten by a higher layer or by the recycled-row divider copy are left alone",
    "render": "one loop over the two cells; capture resolves near-star/Light (debris_capture_resolve) and a retained mid-frame effect (resolve_effect_backing_below_transient_effect); a cell a rendered effect owns is not written (ENTITY_DRAWN_MASK records written cells)",
    "recycled_bottom_row": "restore chosen over retiring at Y 232: rotate_playfield_rows -> restore_recycled_row_near_and_debris republishes the two cells over the divider copy of the recycled row and re-captures their backing, so the frame that rotates still shows the debris and the next guarded erase restores the copied content; debris keeps colliding down to Y 240",
    "field_contract": "slot-zero debris: ENTITY_BACKING0+0/+1 lower backing of cell 0/1, ENTITY_BACKING2+0/+1 published codes; the A2 resolver's ENTITY_BACKING0,y read (cell index) is now exact for the right cell too",
    "not_changed": [
      "gameplay policy (C)",
      "PMG",
      "A2 kernel bytes and entry points (237 B)",
      "effects (still mid-frame, resolver-backed)",
      "PairShot, Light, pickup PMG and sparse near publication order"
    ]
  },
