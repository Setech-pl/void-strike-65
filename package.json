{
  "name": "void-strike-65",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "description": "A vertical space shooter for Atari 65XE PAL.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:candidate": "node scripts/build.mjs --candidate",
    "build:two-pmg": "node scripts/build.mjs --candidate --two-pmg-raiders",
    "enemy:review": "node scripts/build.mjs --enemy-review",
    "enemy:combat-review": "node scripts/build.mjs --enemy-combat-review",
    "enemy:palette:hostile-oxblood": "node scripts/build.mjs --enemy-palette=hostile-oxblood",
    "enemy:palette:hostile-burgundy": "node scripts/build.mjs --enemy-palette=hostile-burgundy",
    "enemy:palette:hostile-scarlet": "node scripts/build.mjs --enemy-palette=hostile-scarlet",
    "clean": "node scripts/clean.mjs",
    "package": "npm run build && node scripts/package-release.mjs",
    "preview": "node scripts/preview.mjs && node scripts/starfield-preview.mjs",
    "showcase": "node scripts/github-showcase.mjs",
    "play:xex": "node scripts/artifact-launch.mjs xex",
    "play:atr": "node scripts/artifact-launch.mjs atr",
    "boot:smoke": "node scripts/runtime-wall-trace.mjs --boot-smoke-only",
    "runtime:wall-trace": "node scripts/runtime-wall-trace.mjs",
    "test": "node scripts/build.mjs --quiet && node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "romdev-toolchain-cc65": "0.1.3"
  }
}
