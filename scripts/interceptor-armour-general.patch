+/* feat/interceptor-armour (the HD/HE review variants): a Light's hit points
+ * at admission - its record's, plus the difficulty's armour bonus when the
+ * armed wave is armoured (wave_flags bit 5, `armour` in the level source,
+ * Interceptor waves only). Policy in C; the window's last segment, so no
+ * Light C byte moves (only the kernel behind it). */
+#define WAVE_FLAG_ARMOUR 0x20u
+#pragma code-name (push, "HYBRID_C_WINDOW_FLOW")
+#pragma rodata-name (push, "HYBRID_C_WINDOW_RODATA")
+static const uint8_t light_armour_bonus[3] = { 1u, 1u, 1u };
+static uint8_t light_armour(void)
+{
+    light_work = LIGHT_FIELD(ENEMY_ARCHETYPE_FIELD_HIT_POINTS);
+    if ((heavy_wave_flags & WAVE_FLAG_ARMOUR) != 0u) {
+        light_work = (uint8_t)(light_work + light_armour_bonus[DIFFICULTY_SETTING]);
+    }
+    return light_work;
+}
