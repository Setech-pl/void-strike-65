+ * 39 frames, the climb and then the hold; the wrap restarts the standoff with
+ * its descent, and spends a loop. With none left it climbs out as before.
+ * The count is wave_flags bits 6-7 (scripts/level-compiler.mjs), kept per slot
+ * in the same units ($40 a loop). */
+#define INTERCEPTOR_LOOP_MASK    0xC0u
+#define INTERCEPTOR_LOOP_UNIT    0x40u
